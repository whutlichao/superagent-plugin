{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "types": [],
    "lib": ["ES2023"],
    "paths": {
      "orca": ["./types/orca.d.ts"],
      "orca/worker": ["./types/orca-worker.d.ts"],
      "orca/testing": ["./types/orca-testing.d.ts"]
    }
  },
  "include": ["src", "tests", "types"]
}
